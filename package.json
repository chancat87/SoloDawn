{
  "name": "solodawn",
  "version": "0.0.153",
  "private": true,
  "scripts": {
    "lint": "npm run frontend:lint && npm run backend:lint",
    "format": "cargo fmt --all && cd frontend && npm run format",
    "check": "npm run frontend:check && npm run backend:check",
    "dev": "node scripts/run-dev.js",
    "dev:release": "node scripts/run-dev.js --release",
    "frontend:lint": "cd frontend && npm run lint",
    "frontend:dev": "node scripts/run-frontend-dev.js",
    "frontend:check": "cd frontend && npm run check",
    "backend:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "backend:dev": "BACKEND_PORT=$(node scripts/setup-dev-environment.js backend) npm run backend:dev:watch",
    "backend:dev:standalone": "cargo run -p server",
    "backend:dev:standalone:release": "cargo run --release -p server",
    "backend:check": "cargo check",
    "backend:dev:watch": "DISABLE_WORKTREE_ORPHAN_CLEANUP=1 RUST_LOG=debug cargo watch -w crates -x 'run --bin server'",
    "dev:qa": "export FRONTEND_PORT=$(node scripts/setup-dev-environment.js frontend) && export BACKEND_PORT=$(node scripts/setup-dev-environment.js backend) && concurrently \"npm run backend:dev:watch:qa\" \"npm run frontend:dev\"",
    "generate-types": "cargo run --bin generate_types",
    "generate-types:check": "cargo run --bin generate_types -- --check",
    "prepare-db": "node scripts/prepare-db.js",
    "prepare-db:check": "node scripts/prepare-db.js --check",
    "quality": "bash scripts/quality/run-quality-gate.sh repo enforce",
    "quality:check": "bash scripts/quality/run-quality-gate.sh repo shadow",
    "quality:sonar": "bash scripts/quality/run-sonar-scanner.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "devalue": "5.9.0",
      "preact": "10.29.8",
      "uuid": "13.0.1",
      "yaml": "2.8.3",
      "brace-expansion": "2.0.3",
      "minimatch@8": "8.0.6",
      "minimatch@9": "9.0.7",
      "glob@10": "10.5.0",
      "lodash-es": "4.18.1",
      "diff": "8.0.3",
      "lodash": "4.18.1",
      "fast-uri": "3.1.2",
      "postcss": "8.5.26"
    }
  }
}
