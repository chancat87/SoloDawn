# ============================================================================
# .ci/Dockerfile.security-patrol
#
# 供 CNB 流水线中 npc:go（AI Agent）阶段使用的运行环境镜像：
#   * 内置 CNB CLI 与 Skills（CNB 官方推荐做法），使 Agent 具备
#     cnb 命令、代码读写、PR 创建等能力；
#   * 内置 jq / curl / git / node，供告警采集与验证脚本使用。
#
# 构建：由 .cnb.yml 中 docker.build 动态构建并缓存到制品库。
# 安全：最小化安装，不包含任何密钥；密钥一律通过 imports 注入；
#       所有工具/依赖锁定精确版本，安装时跳过生命周期脚本（供应链最小化）。
# NOSONAR(S6471): 本镜像为 CNB 流水线专用的 AI 巡检 Agent 镜像（非对外服务），
#   AI Agent 需要 root 权限读写工作区与系统目录，root 是必要且有意的。
# ============================================================================
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git git-lfs curl jq ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install \
    && npm install -g --ignore-scripts @cnbcool/cnb-cli@1.11.1 skills@1.5.22 \
    && npx --yes skills@1.5.22 add https://cnb.cool/cnb/skills/cnb-skill.git -g -y

WORKDIR /workspace
