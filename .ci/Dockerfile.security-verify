# ============================================================================
# .ci/Dockerfile.security-verify
#
# 供 CNB 安全修复验证流水线（api_trigger_security_verify）使用的运行环境镜像：
#   * 完整 Rust nightly 工具链（与仓库 rust-toolchain.toml 一致）+ clippy/rustfmt；
#   * cargo-nextest（与仓库 CI 一致的测试运行器）；
#   * Node + pnpm（前端 lint/check/test）；
#   * CNB CLI 与 Skills（AI 独立审核、PR 操作）；
#   * jq / curl / git / ripgrep（告警采集与验证脚本）。
#
# 构建：由 .cnb.yml 中 docker.build 动态构建并缓存到制品库（按版本哈希复用）。
# 安全：不包含任何密钥；密钥一律通过 imports 注入。
# NOSONAR(S6471): 本镜像为 CNB 流水线专用的编译/验证工具链镜像（非对外服务），
#   cargo/pnpm/git 需要 root 权限写入 /usr/local/{cargo,rustup,lib/node_modules} 等
#   系统目录以完成依赖安装与 AI Agent 的读写操作，root 是必要且有意的。
# ============================================================================
# NOSONAR
FROM node:22-bookworm-slim

# 系统依赖（对齐 .github/actions/setup-rust/action.yml）
# 注意：aws-lc-sys 构建需要 Go >= 1.20，Debian bookworm 的 golang-go 仅 1.19，
# 因此 Go 在下方单独从 go.dev 官方安装最新稳定版（锁定版本 + SHA-256 校验）。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       pkg-config libsqlite3-dev libgit2-dev zlib1g-dev cmake ninja-build \
       clang libclang-dev perl nasm libssl-dev protobuf-compiler libprotobuf-dev make \
       ca-certificates git git-lfs curl jq ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install

# Go 工具链（aws-lc-sys 构建需要；锁定 1.26.5 并校验 SHA-256）
ENV GO_VERSION=1.26.5 \
    GO_HOME=/usr/local/go \
    PATH=/usr/local/go/bin:$PATH
RUN curl -fsSL --retry 5 --proto '=https' --proto-redir '=https' \
      -o /tmp/go.tar.gz \
      https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz \
    && echo "5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053  /tmp/go.tar.gz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && go version

# Rust 工具链（nightly，与 rust-toolchain.toml 保持一致）
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
# NOSONAR
# rustup-init 是 rust-lang 官方签名安装器（sh.rustup.rs 经 HTTPS 提供，
# 脚本由官方 rust-lang/rustup 仓库发布），先下载到文件再执行以避免管道直接运行，
# 属于可接受的官方工具链引导做法。
RUN curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init https://sh.rustup.rs \
    && sh /tmp/rustup-init -y --profile minimal \
    && rm /tmp/rustup-init \
    && rustup toolchain install nightly-2025-12-04 --profile default \
       --component clippy,rustfmt,rustc,rust-src,rust-std,cargo \
    && rustup default nightly-2025-12-04 \
    && rustup component add clippy rustfmt

# cargo-nextest（与仓库 CI 版本一致 0.9.88）
# S8482: 先下载到文件、通过 HTTPS 强制与 gzip 完整性校验后再解压，
# 避免直接管道执行未经验证的下载产物。
RUN curl -LsSf --retry 5 --retry-connrefused --proto '=https' --proto-redir '=https' \
      -o /tmp/nextest.tar.gz \
      https://get.nexte.st/0.9.88/linux \
    && gzip -t /tmp/nextest.tar.gz \
    && tar zxf /tmp/nextest.tar.gz -C /usr/local/bin \
    && rm /tmp/nextest.tar.gz \
    && cargo-nextest --version

# pnpm（仓库 packageManager 为 pnpm@10.13.1，锁定精确版本）
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# CNB CLI 与 Skills（AI 审核 / PR 操作；锁定精确版本防供应链漂移）
# S8543/S6505: npm install 使用 --ignore-scripts；skills 已全局安装，直接调用
#   本地 CLI（不走 npx 按需下载），避免运行未经锁定的下载产物。
RUN npm install -g --ignore-scripts @cnbcool/cnb-cli@1.11.1 skills@1.5.22 \
    && skills add https://cnb.cool/cnb/skills/cnb-skill.git -g -y

WORKDIR /workspace
